  "cli.usage.skills": "Usage: nexa skills <subcommand>\n\n  list               List installed skills\n  validate           Validate all skill manifests\n  info <name>        Show skill details\n  install <url>      Install skill from a GitHub repo or SKILL.md URL\n  create <name>      Scaffold a new SKILL.md skill\n  remove <name>      Remove an installed skill\n\n  install/create/remove accept: --agent <name> (agent scope), --overwrite (install), --home <path>\n",
