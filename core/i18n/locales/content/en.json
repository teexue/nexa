{
  "cli.usage.main": "Usage:\n  nexa                       Start the Web UI (default :8080)\n  nexa web                   Same as above\n  nexa web --addr :9090      Listen on a custom address\n\n  nexa run --agent NAME --prompt \"...\"   One-shot agent run\n  nexa run --continue                    Continue the agent's latest session\n  nexa chat                              Interactive REPL (hidden)\n  nexa sessions list|resume|delete       Manage saved sessions\n\n  nexa config init           Interactive setup for ~/.nexa\n  nexa config set provider ...  Configure a provider from the CLI\n  nexa config set-key ENV KEY   Save an API key\n  nexa config show           Show current configuration\n\n  nexa tools                 List registered tools\n  nexa skills                Manage skills\n  nexa version               Print version\n\n  Default config dir: ~/.nexa\n  Override with --home; use --mock for offline debugging\n\n  nexa config --help         More config subcommands\n",
  "cli.usage.config": "Usage:\n  nexa config init\n  nexa config show\n  nexa config set default-agent NAME\n  nexa config set provider NAME [flags]\n  nexa config set-key ENV_NAME API_KEY\n",
